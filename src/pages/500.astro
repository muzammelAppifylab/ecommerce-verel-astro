---
/**
 * What a visitor sees when a page fails on the server (an error thrown while rendering), instead of an
 * empty answer. Astro renders it with a 500 status. VAREL `layout/RouteError.tsx`: the storefront chrome
 * around a bordered empty state, "Try again" (this same address again) and "Shop the collection".
 *
 * It reads no visitor and no page data: only the chrome, which falls back to VAREL's built-in copy and
 * menus when its reads fail (database down), so whatever broke the page does not break this one.
 * Words from the bundled `layout:error.*` catalog in the URL's language. The error itself is never shown
 * here; it is in the Worker's log.
 *
 * In `npm run dev` and the editor Preview you see Astro's error overlay instead, with the stack trace.
 */
import {buttonClasses} from '@/components/varel/Button';
import Storefront from '@/layouts/Storefront.astro';
import {t} from '@/lib/i18n/server';
import {href} from '@/lib/links';
import {GUEST} from '@/platform/auth';

const locale = (Astro.locals as {locale?: string} | undefined)?.locale ?? 'en';
// "Try again" loads the address that failed (with its locale prefix and query), like VAREL's router.invalidate().
const again = `${Astro.originPathname ?? Astro.url.pathname}${Astro.url.search}`;
const shop = href('/shop/', locale);
---

<Storefront site={null} viewer={GUEST} title={t(locale, 'layout', 'error.title')} noindex>
  <div class="mx-auto w-full max-w-page px-6 py-24 md:px-12">
    <div class="flex flex-col items-center gap-4 border border-hairline px-6 py-16 text-center md:px-12 md:py-24">
      <h1 class="m-0 font-display text-display-4 font-normal">{t(locale, 'layout', 'error.heading')}</h1>
      <p class="m-0 max-w-[40ch] text-[15px] text-text-secondary">{t(locale, 'layout', 'error.body')}</p>
      <div class="mt-2">
        <div class="flex flex-wrap justify-center gap-3">
          <a href={again} class={buttonClasses({variant: 'outline'})} rel="nofollow">{t(locale, 'layout', 'error.tryAgain')}</a>
          <a href={shop} class={buttonClasses()}>{t(locale, 'layout', 'error.shop')}</a>
        </div>
      </div>
    </div>
  </div>
</Storefront>
