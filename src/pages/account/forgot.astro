---
/**
 * Forgot password: step 1 of VAREL `src/pages/ResetPassword.tsx` (stages "request" and "sent"), on the
 * template's flow. Posts to `/site-api/auth/forgot-password`, which always answers the same (it never
 * says whether the email has an account); the platform relays the email (link valid 30 minutes).
 * "I have the link" goes to step 2 (`/account/reset/`, where the link can be pasted).
 *
 * ON DEMAND so `/da/account/forgot/` renders in Danish (PLAN.md D7); no visitor data in the HTML.
 */
import '../../components/auth/auth.css';

import {Icon} from '@/components/varel/Icon';

import AuthCopy from '../../components/auth/AuthCopy.astro';
import AuthField from '../../components/auth/AuthField.astro';
import ResetSteps from '../../components/auth/ResetSteps.astro';
import {pathIn, tFor} from '../../components/auth/auth-server';
import {INTRO, QUIET_LINK, SECONDARY_OUTLINE, SECONDARY_SOLID, SUBMIT, TITLE_44} from '../../components/auth/classes';
import {AUTH_IMAGES} from '../../components/layout/auth-images';
import AuthShell from '../../layouts/AuthShell.astro';
import {staticContext} from '../../server/page';

export const prerender = false;

const {site, viewer} = await staticContext(Astro.request);
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale, 'auth');
const href = pathIn(locale);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<AuthShell site={site} viewer={viewer} isStatic noindex title={t('reset.title')} image={AUTH_IMAGES.reset} imageSide="right" maxWidth={440}>
  <div class="auth-page flex flex-col">
    <AuthCopy locale={locale} />
    <ResetSteps active={1} label={t('reset.steps.label')} steps={[t('reset.steps.request'), t('reset.steps.new')]} />

    <!-- Stage "request" -->
    <div id="forgot-request" class="flex flex-col">
      <h1 class={TITLE_44}>{t('reset.requestTitle')}</h1>
      <p class={INTRO}>{t('reset.requestIntro')}</p>
      <form id="forgot-form" class="flex flex-col gap-[26px]" novalidate>
        <AuthField id="forgot-email" name="email" type="email" label={t('email')} autocomplete="email" inputmode="email" maxlength={254} />
        <p class="notice" data-form-status hidden></p>
        <button class={SUBMIT} type="submit">{t('reset.send')}</button>
      </form>
    </div>

    <!-- Stage "sent" -->
    <div id="forgot-sent" class="flex flex-col" tabindex="-1" hidden>
      <h1 class={TITLE_44}>{t('reset.sentTitle')}</h1>
      <p class={INTRO.replace('mb-9', 'mb-7')} id="forgot-sent-intro">{t('reset.sentIntro', {email: t('reset.yourEmail')})}</p>
      <div role="status" class="mb-7 flex items-center gap-3 border border-signal-positive p-4 text-body-xs text-signal-positive">
        <Icon name="check" size={16} />
        {t('reset.sentStatus')}
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={href('/account/reset/')} class={SECONDARY_SOLID}>{t('reset.haveLink')}</a>
        <button type="button" id="forgot-another" class={SECONDARY_OUTLINE}>{t('reset.anotherEmail')}</button>
      </div>
    </div>

    <a href={href('/account/login/')} class:list={[QUIET_LINK, 'mt-7']}>{t('backToSignIn')}</a>
  </div>
</AuthShell>

<script>
  import {authRules, readCopy} from '../../components/auth/auth-page';
  import {localizeProblem} from '../../components/auth/messages';
  import {bindForm, postJson} from '../../lib/form';
  import {siteFetch} from '../../platform/browser';

  // Client navigation (ClientRouter): runs on every `astro:page-load` while it is this page.
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#forgot-form');
    if (!form) return;
    const t = readCopy();
    const R = authRules(t);
    const request = document.getElementById('forgot-request')!;
    const sent = document.getElementById('forgot-sent')!;
    const intro = document.getElementById('forgot-sent-intro')!;
    const input = form.elements.namedItem('email') as HTMLInputElement;

    bindForm(form, {
      rules: {email: R.email},
      pendingLabel: t('login.sending'),
      async submit(values) {
        const address = String(values.email).trim();
        const {res, data, result} = await postJson(siteFetch, '/site-api/auth/forgot-password', {email: address});
        if (!result.ok) return localizeProblem(res, data, t);
        intro.textContent = t('reset.sentIntro', {email: address || t('reset.yourEmail')});
        request.hidden = true;
        sent.hidden = false;
        sent.focus();
        return {ok: true};
      },
    });

    // VAREL "Use another email": back to the request form, the address kept, the status cleared.
    document.getElementById('forgot-another')!.addEventListener('click', () => {
      sent.hidden = true;
      request.hidden = false;
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      if (status) status.hidden = true;
      input.focus();
      input.select();
    });
  });
</script>
