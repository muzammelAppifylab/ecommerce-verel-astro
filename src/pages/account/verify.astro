---
/**
 * Confirm an email address from an emailed link (`?token=`, single use, 24 hours): the template's flow in
 * VAREL's auth look and copy. The visitor presses a button to confirm: links in emails are often opened by
 * scanners, which must not use the token up. An expired link offers to send a new one.
 *
 * ON DEMAND so `/da/account/verify/` renders in Danish (PLAN.md D7). A secret travels in the URL:
 * `secretInUrl` (no Referer) and `no-store`.
 */
import '../../components/auth/auth.css';

import AuthCopy from '../../components/auth/AuthCopy.astro';
import AuthField from '../../components/auth/AuthField.astro';
import {pathIn, tFor} from '../../components/auth/auth-server';
import {INTRO, QUIET_LINK, SECONDARY_OUTLINE, SUBMIT, TITLE_44} from '../../components/auth/classes';
import {AUTH_IMAGES} from '../../components/layout/auth-images';
import AuthShell from '../../layouts/AuthShell.astro';
import {staticContext} from '../../server/page';

export const prerender = false;

const {site, viewer} = await staticContext(Astro.request);
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale, 'auth');
const href = pathIn(locale);
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AuthShell
  site={site}
  viewer={viewer}
  isStatic
  noindex
  secretInUrl
  title={t('verify.title')}
  image={AUTH_IMAGES.reset}
  imageSide="right"
  maxWidth={440}>
  <div class="auth-page flex flex-col">
    <AuthCopy locale={locale} />
    <h1 class={TITLE_44}>{t('verify.title')}</h1>

    <form id="verify-form" class="flex flex-col gap-[26px]" novalidate data-signin={href('/account/login/')}>
      <p class={INTRO.replace('mb-9', 'mb-0')}>{t('verify.intro')}</p>
      <p class="notice" data-form-status hidden></p>
      <button class={SUBMIT} type="submit">{t('verify.submit')}</button>
    </form>

    <form id="resend-form" class="mt-9 flex flex-col gap-[26px]" novalidate hidden>
      <p class={INTRO.replace('mb-9', 'mb-0')}>{t('verify.resendIntro')}</p>
      <AuthField id="resend-email" name="email" type="email" label={t('email')} autocomplete="email" inputmode="email" maxlength={254} />
      <p class="notice" data-form-status hidden></p>
      <button class={SECONDARY_OUTLINE} type="submit">{t('verify.resendSubmit')}</button>
    </form>

    <a href={href('/account/login/')} class:list={[QUIET_LINK, 'mt-7']}>{t('backToSignIn')}</a>
  </div>
</AuthShell>

<script>
  import {authRules, readCopy, replaceWithStatus} from '../../components/auth/auth-page';
  import {localizeProblem} from '../../components/auth/messages';
  import {takeToken} from '../../lib/account';
  import {bindForm, postJson} from '../../lib/form';
  import {siteFetch} from '../../platform/browser';

  // Client navigation (ClientRouter): runs on every `astro:page-load` while it is this page.
  document.addEventListener('astro:page-load', () => {
    const verify = document.querySelector<HTMLFormElement>('#verify-form');
    if (!verify) return;
    const t = readCopy();
    const R = authRules(t);
    const token = takeToken();
    const resend = document.querySelector<HTMLFormElement>('#resend-form')!;
    const signIn = {href: verify.dataset.signin || '/account/login/', text: t('signIn')};
    const offerResend = () => {
      resend.hidden = false;
    };
    if (!token) {
      verify.hidden = true;
      offerResend();
    }

    bindForm(verify, {
      rules: {},
      pendingLabel: t('verify.confirming'),
      async submit() {
        const {res, data, result} = await postJson(siteFetch, '/site-api/auth/verify-email', {token});
        if (result.ok) {
          // An owner address that must choose its password first gets no Sign in link (template verifyOutcome).
          if (data?.setPassword === true) replaceWithStatus(verify, t('verify.setPassword'));
          else replaceWithStatus(verify, t('verify.done'), signIn);
          return {ok: true};
        }
        offerResend();
        return localizeProblem(res, data, t);
      },
    });

    bindForm(resend, {
      rules: {email: R.email},
      pendingLabel: t('login.sending'),
      async submit(values) {
        const {res, data, result} = await postJson(siteFetch, '/site-api/auth/resend-verification', {email: values.email?.trim()});
        if (!result.ok) return localizeProblem(res, data, t);
        replaceWithStatus(resend, t('verify.resent'));
        return {ok: true};
      },
    });
  });
</script>
