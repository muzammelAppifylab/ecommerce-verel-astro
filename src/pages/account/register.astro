---
/**
 * Create an account (VAREL `src/pages/Signup.tsx` look and copy, the template's sign-up flow).
 *
 * Posts `{name: "<first> <last>", email, password}` to `/site-api/auth/register`. With email
 * confirmation on (src/server/auth-settings.ts) the answer is the same whether or not the email
 * already has an account: "check your inbox" (202). The template's `register` cannot carry VAREL's
 * extras (first / last name, newsletter), so they are kept in this browser (stash.ts) and handed to
 * `POST /site-api/account/onboarding` at the first sign-in. Verification off (201): onboarding now,
 * then `next`.
 *
 * `?email=` prefills the email (order confirmation's "create an account"); `?next=` as on login.
 * ON DEMAND so `/da/account/register/` renders in Danish (PLAN.md D7); no visitor data in the HTML.
 */
import '../../components/auth/auth.css';

import AuthCopy from '../../components/auth/AuthCopy.astro';
import AuthField from '../../components/auth/AuthField.astro';
import AuthRich from '../../components/auth/AuthRich.astro';
import {legalLinks, pathIn, tFor} from '../../components/auth/auth-server';
import {CHECK_INPUT, CHECK_LABEL, INTRO, SUBMIT, TITLE_46} from '../../components/auth/classes';
import {AUTH_IMAGES} from '../../components/layout/auth-images';
import AuthShell from '../../layouts/AuthShell.astro';
import {staticContext} from '../../server/page';

export const prerender = false;

const {site, viewer} = await staticContext(Astro.request);
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale, 'auth');
const href = pathIn(locale);
const reveal = {show: t('reveal.show'), showLabel: t('reveal.showLabel')};
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<AuthShell
  site={site}
  viewer={viewer}
  isStatic
  noindex
  title={t('createAccount')}
  image={AUTH_IMAGES.signup}
  imageSide="left"
  maxWidth={460}>
  <div class="auth-page flex flex-col">
    <AuthCopy locale={locale} />
    <h1 class={TITLE_46}>{t('createAccount')}</h1>
    <p class={INTRO}>{t('signup.intro')}</p>

    <form id="register-form" class="flex flex-col gap-[26px]" novalidate>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <AuthField id="register-first" name="firstName" label={t('firstName')} autocomplete="given-name" maxlength={80} />
        <AuthField id="register-last" name="lastName" label={t('lastName')} autocomplete="family-name" maxlength={80} />
      </div>
      <AuthField id="register-email" name="email" type="email" label={t('email')} autocomplete="email" inputmode="email" maxlength={254} />
      <AuthField
        id="register-password"
        name="password"
        label={t('password')}
        autocomplete="new-password"
        maxlength={128}
        describedby="register-password-checks"
        reveal={reveal}>
        <div class="auth-strength flex flex-col gap-2" id="register-strength" data-level="0">
          <div class="flex items-center gap-3">
            <span class="relative block h-0.5 flex-1 overflow-hidden bg-ink-200" aria-hidden="true">
              <span class="auth-strength-bar block"></span>
            </span>
            <span class="text-label-sm tracking-label uppercase" data-strength-label aria-live="polite">{t('strength.empty')}</span>
          </div>
          <span class="text-label-md text-text-muted">{t('strength.hint')}</span>
        </div>
        <ul class="pw-checks" id="register-password-checks"><li>{t('checks.length', {min: 10})}</li></ul>
      </AuthField>

      <label class={CHECK_LABEL}>
        <input type="checkbox" name="terms" id="register-terms" class={CHECK_INPUT} />
        <span><AuthRich text={t('signup.terms')} links={legalLinks(locale)} /></span>
      </label>
      <label class={CHECK_LABEL}>
        <input type="checkbox" name="newsletter" id="register-newsletter" class={CHECK_INPUT} checked />
        <span>{t('signup.newsletter')}</span>
      </label>

      <p class="notice notice-error" id="register-terms-alert" role="alert" hidden>{t('signup.acceptTerms')}</p>
      <p class="notice" data-form-status hidden></p>
      <button class={SUBMIT} type="submit">{t('signup.submit')}</button>
    </form>

    <span class="mt-7 text-body-sm text-text-secondary" id="register-have-account">
      {t('signup.haveAccount')}
      <a href={href('/account/login/')} data-keep-next class="border-b border-strong pb-0.5 text-text-primary">{t('signIn')}</a>
    </span>
  </div>
</AuthShell>

<script>
  import {authRules, finishSignIn, keepNext, readCopy, replaceWithStatus} from '../../components/auth/auth-page';
  import {localizeProblem} from '../../components/auth/messages';
  import {authNext} from '../../components/auth/next';
  import {
    bindLocalizedPasswordChecks,
    bindLocalizedReveal,
    bindStrengthMeter,
    localizedPasswordRule,
  } from '../../components/auth/password-ui';
  import {clearStash, writeStash} from '../../components/auth/stash';
  import {signedIn} from '../../lib/account';
  import {bindForm, postJson} from '../../lib/form';
  import {rules} from '../../lib/rules';
  import {siteFetch} from '../../platform/browser';

  /** `users.name` is at most 80 characters: first and last name together. */
  const NAME_MAX = 80;

  // Client navigation (ClientRouter): a bundled script runs once, so this page's code runs on
  // every `astro:page-load` while it is this page.
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#register-form');
    if (!form) return;
    const t = readCopy();
    const R = authRules(t);
    const next = authNext();
    keepNext(next);
    void signedIn().then(yes => yes && window.location.replace(next));

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const first = field('firstName');
    const last = field('lastName');
    const email = field('email');
    const password = field('password');
    const terms = field('terms');
    const newsletter = field('newsletter');
    const termsAlert = document.getElementById('register-terms-alert')!;

    // `?email=` from the order confirmation: prefill when it is a real address.
    const prefill = new URLSearchParams(window.location.search).get('email')?.trim();
    if (prefill && !email.value && R.email.every(rule => rule(prefill) === null)) email.value = prefill;

    bindLocalizedReveal(form, t);
    bindLocalizedPasswordChecks(password, document.getElementById('register-password-checks')!, t, {email});
    bindStrengthMeter(password, document.getElementById('register-strength')!, t);

    // VAREL: an unticked terms box blocks the sign-up and says so, alongside the field errors.
    // (Registered before bindForm's listener, so it runs even when a field is wrong.)
    form.addEventListener('submit', () => {
      termsAlert.hidden = terms.checked;
    });
    terms.addEventListener('change', () => {
      if (terms.checked) termsAlert.hidden = true;
    });

    const fullName = () => `${first.value.trim()} ${last.value.trim()}`.trim();

    bindForm(form, {
      rules: {
        firstName: [rules.required(t('firstNameRequired')), rules.maxLength(NAME_MAX, t('signup.nameTooLong'))],
        lastName: [
          rules.required(t('lastNameRequired')),
          value => (`${first.value.trim()} ${value.trim()}`.length > NAME_MAX ? t('signup.nameTooLong') : null),
        ],
        email: R.email,
        password: [localizedPasswordRule(t, () => email.value)],
      },
      pendingLabel: t('signup.creating'),
      async submit(values) {
        if (!terms.checked) {
          termsAlert.hidden = false;
          terms.focus();
          return {ok: false};
        }
        const address = String(values.email).trim();
        // Kept BEFORE the request: the confirmation link may be opened before this page hears back.
        writeStash({email: address, firstName: first.value.trim(), lastName: last.value.trim(), newsletter: newsletter.checked});
        const {res, data, result} = await postJson(siteFetch, '/site-api/auth/register', {
          name: fullName(),
          email: address,
          password: values.password,
        });
        // Email confirmation off: signed in now.
        if (res?.status === 201) return finishSignIn(next, address, data?.next);
        if (result.ok) {
          replaceWithStatus(form, t('signup.checkInbox'));
          document.getElementById('register-have-account')?.setAttribute('hidden', '');
          return {ok: true};
        }
        if (res && res.status >= 400 && res.status < 500) clearStash();
        if (data?.error === 'email_taken') return {ok: false, fields: {email: t('signup.emailTaken')}};
        const failure = localizeProblem(res, data, t);
        // The server checks the joined name: its error belongs under the name fields.
        if (failure.fields?.name) {
          const {name: _name, ...rest} = failure.fields;
          return {...failure, fields: {...rest, lastName: t('signup.nameTooLong')}};
        }
        return failure;
      },
    });
  });
</script>
