---
/**
 * The home page (port of VAREL src/pages/Home.tsx, the editorial home). SERVER-RENDERED: its data lives in the
 * Site Database and is edited live (hero, featured products, collections, posts), and `/da/` etc. reach it by
 * a rewrite (src/middleware.ts), which a prerendered page cannot take.
 *
 * Every read goes through the in-process Site API, all at once; each one may fail (`null`) and the page still
 * renders: the hero falls back to the designed copy, sections without data are left out, New in loads in the
 * browser, the featured piece shows VAREL's fallback copy.
 *
 * Sections (VAREL order): hero (full bleed) · shop by category · new in · featured piece · values ·
 * the best part · featured edit (products + collections) · new collections · collections accordion · journal.
 * Server-only sections ship no JS; the five interactive ones are `client:visible` islands, each handed only
 * the word catalogs it renders.
 */
import {BestPart} from '@/components/home/BestPart';
import {CollectionsAccordion} from '@/components/home/CollectionsAccordion';
import {FeaturedCollections} from '@/components/home/FeaturedCollections';
import FeaturedPiece from '@/components/home/FeaturedPiece.astro';
import {FeaturedRow} from '@/components/home/FeaturedRow';
import {heroDefaults, resolveHero} from '@/components/home/hero';
import {HomeHero} from '@/components/home/HomeHero';
import {HomeValues} from '@/components/home/HomeValues';
import {JournalTeaser} from '@/components/home/JournalTeaser';
import {NewCollections} from '@/components/home/NewCollections';
import {NewInSection} from '@/components/home/NewInSection';
import {FEATURED_SLUG, featuredCollectionsOf, NEW_IN_LIMIT} from '@/components/home/sections';
import {ShopByCategory} from '@/components/home/ShopByCategory';
import {dictsFor, serverText} from '@/components/layout/dictionaries';
import {DEFAULT_LOCALE} from '@/components/varel/href';
import Storefront from '@/layouts/Storefront.astro';
import type {Department, Product, ProductListResponse} from '@/lib/types/catalog';
import type {CollectionSummary} from '@/lib/types/collections';
import type {Post} from '@/lib/types/content';
import type {PublicSettings} from '@/lib/types/settings';
import {read} from '@/server/backend';
import {serverT} from '@/server/lib/i18n/messages';
import {pageContext} from '@/server/page';

export const prerender = false;

const locale = (Astro.locals as {locale?: string}).locale ?? DEFAULT_LOCALE;
const {api, site, viewer} = await pageContext(Astro.request, Astro.response);

/* The Site API client, loosely typed: the catalog, product, collection and journal routes belong to other
   packages and their query validators define the typed shape; the paths and queries here are their contract. */
type Get = {$get: (args?: unknown, init?: {headers?: Record<string, string>}) => Promise<Response>};
const client = api as unknown as {
  settings: {public: Get};
  taxonomy: Get;
  products: Get & {':slug': Get};
  collections: Get;
  posts: Get;
};
const init = {headers: {'x-locale': locale}};
const [settings, departments, newIn, featured, piece, collections, posts] = await Promise.all([
  read<PublicSettings>(client.settings.public.$get(undefined, init)),
  read<Department[]>(client.taxonomy.$get(undefined, init)),
  read<ProductListResponse>(client.products.$get({query: {sort: 'featured', limit: String(NEW_IN_LIMIT)}}, init)),
  read<ProductListResponse>(client.products.$get({query: {featured: 'true', limit: '8'}}, init)),
  read<Product>(client.products[':slug'].$get({param: {slug: FEATURED_SLUG}}, init)),
  read<CollectionSummary[]>(client.collections.$get({query: {featured: 'true'}}, init)),
  read<Post[]>(client.posts.$get(undefined, init)),
]);

const currency = settings?.currency || 'USD';
const homeText = serverText(locale);
const home = (key: string) => homeText('home', key);
const hero = resolveHero(settings?.homeHero, heroDefaults(home));

/* Words: server-only sections get whole namespaces (nothing is shipped); islands only what they render. */
const ssrDicts = dictsFor(locale, {home: true, collections: ['imageAlt', 'pieces_one', 'pieces_other', 'card']});
const pieces = ['pieces_zero', 'pieces_one', 'pieces_two', 'pieces_few', 'pieces_many', 'pieces_other'];
const newInDicts = dictsFor(locale, {home: [...pieces, 'newIn'], product: ['tile']});
const featuredDicts = dictsFor(locale, {home: ['featured'], product: ['tile']});
const pieceDicts = dictsFor(locale, {home: ['piece'], product: ['tile', 'buy']});
const bestPartDicts = dictsFor(locale, {home: ['bestPart', 'shopCollection'], catalog: pieces});
const accordionDicts = dictsFor(locale, {home: ['collections', 'shopCollection']});

const departmentList = Array.isArray(departments) ? departments : null;
const newInInitial = newIn && Array.isArray(newIn.items) ? newIn : null;
const featuredItems = featured && Array.isArray(featured.items) ? featured.items : [];
const collectionList = Array.isArray(collections) ? collections : [];
const showCollections = featuredCollectionsOf(collectionList).items.length > 0;
const postList = Array.isArray(posts) ? posts : [];

/* SEO (VAREL useSeo() + html.ts storeSeo): the admin's SEO title/description, else the designed defaults.
   Base appends the site name to `title`, so the designed default title is the site name alone. */
const description = settings?.seoDescription?.trim() || serverT(locale, 'seo.defaultDescription');
const seoTitle = settings?.seoTitle?.trim() || undefined;
const og = settings?.ogImage?.trim() || null;
const ogImage =
  og && /^https:\/\/images\.unsplash\.com\//.test(og) && !og.includes('?')
    ? `${og}?auto=format&fit=crop&w=1200&h=630&q=80`
    : og;
---

<Storefront site={site} viewer={viewer} api={api} title={seoTitle} description={description} image={ogImage}>
  <HomeHero hero={hero} locale={locale} dicts={ssrDicts} />
  <div class="mx-auto max-w-page">
    {
      departmentList && departmentList.length > 0 && (
        <ShopByCategory departments={departmentList} locale={locale} dicts={ssrDicts} />
      )
    }
    <NewInSection client:visible initial={newInInitial} locale={locale} dicts={newInDicts} currency={currency} />
    <FeaturedPiece product={piece} locale={locale} dicts={pieceDicts} currency={currency} />
    <HomeValues locale={locale} dicts={ssrDicts} />
    <BestPart client:visible departments={departmentList} locale={locale} dicts={bestPartDicts} />
    {
      (featuredItems.length > 0 || showCollections) && (
        <section
          aria-label={home('featured.eyebrow')}
          class="flex flex-col gap-16 px-6 py-16 md:gap-24 md:px-12 md:py-24">
          {featuredItems.length > 0 && (
            <FeaturedRow client:visible items={featuredItems} locale={locale} dicts={featuredDicts} currency={currency} />
          )}
          {showCollections && <FeaturedCollections collections={collectionList} locale={locale} dicts={ssrDicts} />}
        </section>
      )
    }
    <NewCollections locale={locale} dicts={ssrDicts} />
    <CollectionsAccordion client:visible locale={locale} dicts={accordionDicts} />
    {postList.length > 0 && <JournalTeaser posts={postList} locale={locale} dicts={ssrDicts} />}
  </div>
</Storefront>
