---
/**
 * /about/ — the brand story (VAREL `src/pages/About.tsx`). Rendered on request (not prerendered) so the
 * language prefixes (`/da/about/`) reach it (PLAN.md D7); it reads nothing of its own but the store's
 * SEO description. Server HTML only (no island).
 */
import {AboutView} from '@/components/pages/AboutView';
import {clip} from '@/components/pages/policy';
import {dictsFor} from '@/components/layout/dictionaries';
import Storefront from '@/layouts/Storefront.astro';
import {t} from '@/lib/i18n/server';
import type {PublicSettings} from '@/lib/types/settings';
import {read} from '@/server/backend';
import {pageContext} from '@/server/page';

export const prerender = false;

const locale = Astro.locals.locale ?? 'en';
const {api, site, viewer} = await pageContext(Astro.request, Astro.response);
const settings = await read<Partial<PublicSettings>>(api.settings.public.$get());
const description = (settings as {seoDescription?: string} | null)?.seoDescription?.trim() || clip(t(locale, 'about', 'hero.body'));
const dicts = dictsFor(locale, {about: true, layout: ['ui']});
---

<Storefront api={api} site={site} viewer={viewer} title={t(locale, 'about', 'title')} description={description}>
  <AboutView locale={locale} dicts={dicts} />
</Storefront>
