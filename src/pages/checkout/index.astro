---
/**
 * `/checkout/` (port of VAREL src/pages/Checkout.tsx + routes/_checkout): the bag's checkout.
 *
 * Every read happens here, in parallel and in-process (the bag, the store's checkout rules, the payment
 * provider, the countries, the signed-in customer's details, then the first country's shipping methods), and
 * the guards VAREL ran in the component run here too:
 *   - the bag could not be read      → 503 + "couldn't load" (never a 404)
 *   - the bag is empty               → 302 to /cart/
 *   - guest checkout off + a guest   → "Sign in to check out" (no JS)
 * Otherwise ONE island (`CheckoutApp`, client:load) gets everything as props.
 *
 * Stripe (D3): only when Stripe is the active provider does this page open its CSP to Stripe's hosts
 * (`allowEmbeddedCheckout`), and only then does the island download Stripe.js. Never indexed.
 */
import CheckoutApp, {type CheckoutRules} from '@/components/checkout/CheckoutApp';
import SignInRequired from '@/components/checkout/SignInRequired.astro';
import {OUTLINE_CTA} from '@/components/checkout/ui';
import {dictsFor, serverText} from '@/components/layout/dictionaries';
import {DEFAULT_LOCALE} from '@/components/varel/href';
import CheckoutShell from '@/layouts/CheckoutShell.astro';
import {cartLink} from '@/lib/links';
import type {AccountOverview} from '@/lib/types/account';
import type {Cart} from '@/lib/types/cart';
import type {CheckoutConfig, ShippingMethodsResponse} from '@/lib/types/orders';
import type {PublicSettings} from '@/lib/types/settings';
import {allowEmbeddedCheckout} from '@/platform/payments';
import {read} from '@/server/backend';
import {pageContext} from '@/server/page';

export const prerender = false;

const locale = (Astro.locals as {locale?: string}).locale ?? DEFAULT_LOCALE;
const t = serverText(locale);
const {api, site, viewer} = await pageContext(Astro.request, Astro.response);
const signedIn = viewer.state === 'user';

const [cart, settings, config, countryList, overview] = await Promise.all([
  read<Cart>(api.cart.$get()),
  read<PublicSettings>(api.settings.public.$get()),
  read<CheckoutConfig>(api.checkout.config.$get()),
  read<string[]>(api.countries.$get()),
  signedIn ? read<AccountOverview>(api.account.overview.$get()) : Promise.resolve(null),
]);

// Store rules (VAREL defaults when the settings can't be read).
const rules: CheckoutRules = {
  guestCheckout: settings?.guestCheckout ?? true,
  requirePhone: settings?.requirePhone ?? false,
  orderNotes: settings?.orderNotes ?? false,
  termsText: settings?.termsText ?? '',
  returnWindowDays: settings?.returnWindowDays ?? 30,
};
const currency = config?.currency || settings?.currency || 'USD';
const countries = Array.isArray(countryList) ? countryList : [];

type View = 'error' | 'sign-in' | 'checkout';
let view: View = 'checkout';
if (!cart) {
  view = 'error';
  Astro.response.status = 503;
} else if (cart.lines.length === 0) {
  return Astro.redirect(cartLink(locale), 302);
} else if (!rules.guestCheckout && !signedIn) {
  view = 'sign-in';
}

// The first country: the primary saved address's, else the store's home (Denmark in VAREL), else the first listed.
const addresses = overview?.addresses ?? [];
const primary = addresses.find(a => a.primary) ?? addresses[0];
const initialCountry =
  primary?.country || (countries.includes('Denmark') ? 'Denmark' : (countries[0] ?? 'Denmark'));
const digitalOnly = !!cart && cart.lines.length > 0 && cart.lines.every(l => l.digital);

let initialMethods: ShippingMethodsResponse | null = null;
if (view === 'checkout' && !digitalOnly) {
  const methodsQuery = {query: {country: initialCountry}};
  initialMethods = await read<ShippingMethodsResponse>(api.shipping.methods.$get(methodsQuery));
}

// Stripe's Payment Element on THIS page only.
if (view === 'checkout' && config?.provider === 'stripe') allowEmbeddedCheckout(Astro.csp, 'stripe');

const user = overview?.user
  ? {email: overview.user.email, name: overview.user.name, phone: overview.user.phone}
  : signedIn && viewer.email
    ? {email: viewer.email, name: viewer.name ?? '', phone: null}
    : null;

const dicts = view === 'checkout' ? dictsFor(locale, {checkout: true}) : {};
const title = view === 'sign-in' ? t('checkout', 'signIn.title') : t('checkout', 'title');
---

<CheckoutShell site={site} viewer={viewer} title={title} noindex currency={currency}>
  {
    view === 'error' && (
      <div class="mx-auto w-full max-w-page px-6 py-24 md:px-12">
        <div class="flex flex-col items-center gap-4 border border-hairline px-6 py-16 text-center md:px-12 md:py-24">
          <h1 class="m-0 font-display text-display-4 font-normal">{t('checkout', 'loadError')}</h1>
          <a href={Astro.url.pathname + Astro.url.search} class:list={[OUTLINE_CTA, 'mt-2 px-8 py-[15px]']}>
            {t('checkout', 'tryAgain')}
          </a>
        </div>
      </div>
    )
  }
  {view === 'sign-in' && <SignInRequired locale={locale} />}
  {
    view === 'checkout' && cart && (
      <CheckoutApp
        client:load
        cart={cart}
        initialMethods={initialMethods}
        initialCountry={initialCountry}
        countries={countries}
        rules={rules}
        config={config}
        currency={currency}
        locale={locale}
        dicts={dicts}
        user={user}
        addresses={addresses}
      />
    )
  }
</CheckoutShell>
