---
/**
 * Obsidian strip above the header (VAREL `layout/AnnouncementBar.tsx`). Scrolls away (not sticky).
 * Text comes from the store settings; the default copy shows when the settings could not be read.
 * Hidden when the setting is empty (`text` null).
 */
interface Props {
  text: string | null;
}
const {text} = Astro.props;
---

{
  text && (
    <div class="bg-ink-900 px-4 py-2.5 text-center font-sans text-label-sm leading-snug tracking-label text-text-inverse uppercase">
      {text}
    </div>
  )
}
