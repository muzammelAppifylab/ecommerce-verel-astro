---
/**
 * "Test mode" on the PUBLISHED site while payments are still in sandbox (no live gateway yet, or
 * the owner holds it in test mode): buyers see that no real money moves. Nothing in the Preview
 * (always sandbox) or when the mode is unknown. Server-rendered pages only (a prerendered page
 * has no Site Key at build): the checkout and thanks pages use it.
 *
 *   <TestModeBadge />                  reads the mode (cached a minute)
 *   <TestModeBadge mode={checkout.mode} />
 */
import {config} from '../../platform/config';
import {listPrices} from '../../platform/payments';

interface Props {
  mode?: 'test' | 'live' | null;
}

let mode = Astro.props.mode ?? null;
if (!mode && config.production && config.siteKey) {
  const catalogue = await listPrices(Astro.url, {ttlSeconds: 60}).catch(() => null);
  mode = catalogue?.ok ? catalogue.data.mode : null;
}
const show = config.production && mode === 'test';
---

{
  show && (
    <p class="test-mode" role="note">
      <span class="test-mode-label">Test mode</span>
      <span>Payments here are tests: no real money moves.</span>
    </p>
  )
}

<style>
  .test-mode {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--warning);
    border-radius: var(--radius-sm);
    background: var(--warning-soft);
    color: var(--ink);
    font-size: 0.875rem;
  }
  .test-mode-label {
    font-weight: 700;
    color: var(--warning);
  }
</style>
